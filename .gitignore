# --- Evidence: raw tenant exports are never committed -------------------------
# Raw exports contain unredacted tenant identifiers, domains, URLs and user data.
# The trailing /* (rather than a bare directory) is deliberate: git will not
# descend into an excluded directory, so a bare `docs/evidence/raw/` would make
# the .gitkeep un-re-includable and the directory absent from a fresh clone.
docs/evidence/raw/*
!docs/evidence/raw/.gitkeep

# Raw / secret artefacts anywhere in the tree
*-raw.json
*-raw.xml
*-raw.csv
*-raw.txt
*-secret.*
*.secret
secrets.json
.env
.env.*
!.env.example

# --- Credentials and certificates ---------------------------------------------
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt

# --- PowerShell / tooling ------------------------------------------------------
*.psd1.bak
PSScriptAnalyzerSettings.local.psd1
TestResults/
*.trx

# --- Editors and OS ------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Logs and scratch ----------------------------------------------------------
*.log
tmp/
temp/
scratch/
